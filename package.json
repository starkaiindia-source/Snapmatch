{
  "name": "mobile-parts-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Compatibility groups for mobile spare parts. Static front end plus Vercel serverless functions for Razorpay billing.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node build.js",
