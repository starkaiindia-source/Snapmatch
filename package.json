    "harfbuzzjs": "1.6.2",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "razorpay": "^2.9.5"
  },
  "devDependencies": {
    "simple-icons": "^16.29.0"
  }
