# dependencies
node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# logs & temp
*.log
tmp/
.tmp/

# Firebase credentials — never commit these
*.serviceaccount.json
serviceAccountKey*.json
.firebaserc.local
firebase-debug.log
.firebase/

# Raw vendor exports and the import report. Regenerate from the workbook with:
#   python scripts/import-xlsx.py "<path>/All_Brands_Models.xlsx"
# build-dataset.js needs data/raw/xlsx_models.json, so run that import before
# the first build on a fresh clone.
data/raw/

# PoC output — regenerate with: node scripts/poc-apple.js
data/build/poc-apple/

# Never commit credentials. Razorpay keys and the Firebase service account
# live in the Vercel project's environment variables and nowhere else.
.env
.env.*
!.env.example

# The paid half of the catalogue — part numbers and fitment lists.
# Generated by scripts/build-runtime-bundle.js into the serverless function
# bundle. NOT committed while this repository is public: pushing it here would
# republish exactly what the subscription sells.
/api/_data/
