# ============================================================================
# Kept out of the upload to Vercel.
#
# vercel.json already allowlists what gets served (index.html, assets/, src/),
# so this file is only about not shipping large or private files at all.
#
# Patterns follow .gitignore rules, so a LEADING SLASH matters: a bare `data/`
# matches a directory of that name at ANY depth — including src/data/, which
# took the app's own modules offline until this was anchored.
# ============================================================================

# Build inputs and the generated dataset. groups.ndjson carries the part
# numbers and fitment lists the subscription pays for, so it must never be
# downloadable from the site. Only scripts/import-firestore.js needs these.
# assets/search-index.json is deliberately NOT excluded: it is the free
# catalogue (model names, brands, years) and holds no paid fields.
/data/
/scripts/

# Backend configuration — deployed with the Firebase CLI, not with the site.
/firebase.json
/firestore.rules
/firestore.indexes.json

# Single-file bundles and their builder; not part of the hosted site.
/dist/
/build.js

# Tooling
/.claude/
/README.md

# Vercel installs dependencies itself from package.json; uploading the local
# tree would be slow and could ship a platform-specific build.
/node_modules/

# Tests run in CI and locally, not in a function bundle.
/api/_lib/*.test.js

# Generated SEO output IS deployed (finder/, models/, categories/, the landing
# pages, robots.txt, sitemap.xml, site.webmanifest and the brand icons) — it is
# the pre-rendered HTML search engines and social cards read. Rebuild it with
#   node scripts/build-seo.js && python scripts/build-icons.py
