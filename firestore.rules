rules_version = '2';

/* ============================================================================
   Mobile Parts Finder — Firestore security rules

   Shape of the data and why:

     /catalog/meta            public   counts + dataset version
     /brands/{id}             public   brand rollups
     /models/{id}             public   phone catalogue (free browsing)
     /groups/{id}             public   group PREVIEW — category, master, count
     /groupDetails/{id}       public   part number, full member list
     /modelGroups/{id}        public   model -> matching group ids
     /users/{uid}             owner    shop profile, self-editable
     /users/{uid}/billing/*   owner-read, server-write only

   The catalogue — including part numbers and fitment lists — is open, matching
   what assets/dataset.json ships. The collections stay split so the split can
   be reinstated: narrow the runtime bundle first, then put hasActivePlan()
   back on groupDetails, modelGroups and deviceGroups.

   Subscription state is never client-writable, and that has not changed. A signed-in user can read
   their own billing document but only a trusted server (Admin SDK or a
   Cloud Function) may create or change it — otherwise anyone could grant
   themselves a plan from the browser console.
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------- helpers */
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function billing() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/billing/subscription).data;
    }
    /* Currently called by nothing: the catalogue is open. Kept, with billing()
       above it, because reinstating the paywall is a matter of naming it again
       on groupDetails, modelGroups and deviceGroups — and rewriting it from
       memory later is how a subscription check ends up subtly wrong. */
    function hasActivePlan() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/billing/subscription)
        && billing().expiresAt > request.time;
    }

    /* ------------------------------------------------------- public catalogue
       Free browsing: anyone may read models, brands and group previews.
       Nothing here is writable from a client; the importer uses the Admin
       SDK, which bypasses these rules. */
    match /catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if false;
    }
    match /models/{modelId} {
      allow read: if true;
      allow write: if false;
    }
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }

    /* ------------------------------------------------------- fitment detail
       Part numbers and full compatible-device lists.

       OPEN TO EVERYONE, by the owner's decision. Keeping them closed here
       would achieve nothing anyway: the same records ship in
       assets/dataset.json, which is a static file one unauthenticated GET
       away. A rule that guards a copy while the original is public is not a
       control, it is a false sense of one.

       Restoring the paywall means narrowing scripts/build-runtime-bundle.js
       FIRST and putting hasActivePlan() back here second — in that order, or
       the rule tightens around data the browser already has. */
    match /groupDetails/{groupId} {
      allow read: if true;
      allow write: if false;
    }
    match /modelGroups/{modelId} {
      allow read: if true;
      allow write: if false;
    }

    /* -------------------------------------------------------------- users */
    match /users/{uid} {

      /* The fields a browser may NEVER write, listed once and applied to both
         create and update.

         This is the line between "details a shop enters about itself" and
         "facts about money". Everything below is written only through the
         Admin SDK — by /api/verify-payment, the Razorpay webhook, or
         /api/profile-sync — and the Admin SDK bypasses these rules entirely.
         Blocking them here is what stops a signed-in user opening the console
         and granting themselves a plan by editing their own profile.

         Declared before the rules that call it: forward references are legal,
         but reading a rule should not require scrolling past it. */
      function serverOwnedFields() {
        return [
          'subscription', 'subscriptionStatus', 'activeSubscriptionStatus',
          'subscriptionPlan', 'currentPlanId', 'currentSubscriptionId',
          'subscriptionStartedAt', 'subscriptionExpiresAt',
          'plan', 'status', 'role', 'accountStatus',
          'lastVerifiedAt', 'lastLoginAt', 'emailVerified',

          /* Search mirrors. Lower-cased copies of the shop's own fields,
             written by api/_lib/store.js so the admin table can search
             case-insensitively — Firestore cannot lower-case at query time.

             Closed to the client for the same reason every derived field is:
             a browser that could write `mobileShopNameLower` independently of
             `mobileShopName` could make its record findable under a name it
             does not have, or unfindable under the one it does. The values are
             recomputed from the real fields on every server-side write, so
             there is nothing here a client would ever legitimately set. */
          'emailLower', 'mobileShopNameLower', 'proprietorNameLower',
          'displayNameLower', 'mobileDigits',

          /* Reserved. Nothing writes this yet; naming it now means a future
             "last seen" stamp cannot be forged by the browser that reports it. */
          'lastActiveAt'
        ];
      }

      /* Only the owner, and only their own document — the uid in the path is
         the identity, so one signed-in shop can never touch another's. */
      /* Split create from update deliberately: on a create there is no
         `resource`, so diffing against it is invalid. A create checks the keys
         being written; an update checks which keys changed. */
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny(serverOwnedFields());

      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields());
      allow delete: if false;

      /* The mandatory shop fields are NOT required here. An incomplete profile
         is a legitimate state — it is how the app knows to ask for the missing
         details — and rejecting the write would leave a signed-in user with no
         record at all, which is worse. profileCompleted is recomputed from the
         fields whenever the profile is read, on the client and again on the
         server before a payment starts, so an incomplete one cannot pass itself
         off as complete. */

      /* billing is readable by its owner and writable only by a server */
      match /billing/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      /* the user's own search history — fully theirs */
      match /recent/{doc} {
        allow read, write: if isOwner(uid);
      }
    }


    /* ------------------------------------------------------ device master
       The canonical catalogue built by the ingestion pipeline. Everything here
       is free to browse: it is what makes the site useful before anyone pays.
       Specs, colours and prices are subcollections so listing the catalogue
       never pays to read a spec sheet nobody opened. */
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if false;                       /* importer uses Admin SDK */

      match /specs/{doc}          { allow read: if true;  allow write: if false; }
      match /colorVariants/{doc}  { allow read: if true;  allow write: if false; }
      match /priceOffers/{doc}    { allow read: if true;  allow write: if false; }
      match /priceHistory/{doc}   { allow read: if true;  allow write: if false; }
      match /pricing/{doc}        { allow read: if true;  allow write: if false; }
    }

    /* The alias -> canonical id bridge. Public because resolving a typed model
       name to a device is the first step of every search. */
    match /aliases/{alias} {
      allow read: if true;
      allow write: if false;
    }

    match /partCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    /* The device -> matching groups shortcut, under its new name. Same terms
       as modelGroups above, which stays until the client is migrated. */
    match /deviceGroups/{deviceId} {
      allow read: if true;
      allow write: if false;
    }

    /* ---------------------------------------------------------- operations
       Source registry, import audit trail and job schedule. No client has any
       reason to read these, and letting one read the source list would expose
       which credentials are configured. Admin SDK only, both ways. */
    match /sources/{sourceId}    { allow read, write: if false; }
    match /importRuns/{runId}    { allow read, write: if false; }
    match /updateJobs/{jobId}    { allow read, write: if false; }


    /* ------------------------------------------------------------- billing
       Written ONLY by the Vercel functions through the Admin SDK, which
       bypasses these rules. Closing writes here is what stops a signed-in user
       from opening the console and granting themselves a subscription — the
       one attack this whole payment design exists to prevent.

       Reads are limited to the owner: a subscriber may see their own invoices
       and nobody else's. */
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    /* ================================================================== admin
       The backend business layer. EVERY collection below is closed to every
       client in both directions — `allow read, write: if false` — and reached
       only through the Admin SDK from the routes under api/admin/*.

       That is the strongest form of the requirement that a normal user must
       not be able to read admin data from the frontend, and it applies to
       administrators too: an admin's browser holds an ordinary Firebase ID
       token, so it cannot read one document here either. Their authority lives
       on the server, in adminUsers/{uid}, and it is the SERVER that reads
       these collections on their behalf after checking it.

       The practical consequence: no rule here can be got wrong in a way that
       leaks. There is no condition to get wrong. Access is decided in
       api/_lib/admin-auth.js, in code that can be read and tested.

       WHY THERE IS NO OWNER-EMAIL CHECK IN THIS FILE

       It would be strictly weaker than what is already here. An owner-only
       rule such as

           allow read: if request.auth.token.email == '...';

       OPENS these collections to a client that satisfies it — a browser, with
       the SDK, able to run any query it likes against every analytics event
       and every admin record. `if false` opens them to nobody, and the owner
       reaches the same data through /api/admin/*, where the server decides
       what to return and logs that it did.

       So: the owner restriction lives in api/_schema/roles.js and is enforced
       in api/_lib/admin-auth.js. There is no admin operation a client can
       reach for a rule here to guard, which is the point. */

    /* Who is an administrator. The registry api/_lib/admin-auth.js consults on
       every admin request — and the reason a Firebase custom claim alone is
       not enough, since a token outlives a revocation by up to an hour. */
    match /adminUsers/{uid}          { allow read, write: if false; }

    /* Append-only record of what administrators did. Closed to clients so that
       not even a super_admin can edit one from a browser: a log its subject
       can rewrite proves nothing. */
    match /adminAuditLog/{entryId}   { allow read, write: if false; }

    /* --------------------------------------------------------- analytics
       Behavioural events and their daily rollups.

       Closed to READS as well as writes, and that is the important half. These
       records describe what visitors did; a collection any signed-in user
       could query would be one shop able to read another's browsing. Writes
       arrive through POST /api/events, which validates every event against an
       allowlist, redacts free text and rate-limits the caller. */
    match /analyticsEvents/{eventId} { allow read, write: if false; }
    match /analyticsDaily/{day}      { allow read, write: if false; }

    /* Anonymous visit records. A random session id the browser generated for
       itself — never a device fingerprint — and closed for the same reason. */
    match /visitorSessions/{id}      { allow read, write: if false; }

    /* --------------------------------------------------------- catalogue ops
       The missing-model queue and the AI approval queue.

       Written only by the server: a client-writable request queue is a client
       that can flood the review list, and a client-writable AI task is a
       client that can put words in an approval screen an administrator is
       about to click through. */
    match /missingModelRequests/{key} { allow read, write: if false; }
    match /aiTasks/{taskId}           { allow read, write: if false; }

    /* Rate-limit buckets. A caller that could read its own bucket learns
       nothing useful; one that could write it would have no limit at all. */
    match /rateLimits/{bucket}        { allow read, write: if false; }

    /* anything not matched above is closed */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
