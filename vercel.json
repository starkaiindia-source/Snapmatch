{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "src/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/__/auth/(.*)", "dest": "https://mobilepartsfinder.firebaseapp.com/__/auth/$1" },
    { "handle": "filesystem" },
    { "src": "/api/([^/.]+)/?$", "dest": "/api/$1.js" }
  ]
}
