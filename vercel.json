{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap-models.xml",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap-pages.xml",
      "use": "@vercel/static"
    },
    {
      "src": "site.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    },
    {
      "src": "finder/**",
      "use": "@vercel/static"
    },
    {
      "src": "models/**",
      "use": "@vercel/static"
    },
    {
      "src": "model/**",
      "use": "@vercel/static"
    },
    {
      "src": "categories/**",
      "use": "@vercel/static"
    },
    {
      "src": "plans/**",
      "use": "@vercel/static"
    },
    {
      "src": "mobile-parts-finder/**",
      "use": "@vercel/static"
    },
    {
      "src": "contact/**",
      "use": "@vercel/static"
    },
    {
      "src": "privacy/**",
      "use": "@vercel/static"
    },
    {
      "src": "terms/**",
      "use": "@vercel/static"
    },
    {
      "src": "refund/**",
      "use": "@vercel/static"
    },
    {
      "src": "universal-tempered-glass/**",
      "use": "@vercel/static"
    },
    {
      "src": "universal-back-cover/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/__/auth/(.*)",
      "dest": "https://mobilepartsfinder.firebaseapp.com/__/auth/$1"
    },
    {
      "src": "/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/about",
      "status": 308,
      "headers": {
        "Location": "/mobile-parts-finder"
      }
    },
    {
      "src": "/assets/(brand|brands|categories)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "/assets/(dataset|search-index).json",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/admin/([^/.]+)/?$",
      "dest": "/api/admin.js?section=$1"
    },
    {
      "src": "/api/(firebase-config|plans|health)/?$",
      "dest": "/api/public.js?section=$1"
    },
    {
      "src": "/api/(access|device-parts)/?$",
      "dest": "/api/access.js?section=$1"
    },
    {
      "src": "/api/([^/.]+)/?$",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin(?:/.*)?$",
      "dest": "/admin/index.html"
    },
    {
      "src": "/(account|group)(?:/.*)?$",
      "dest": "/finder/index.html"
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
