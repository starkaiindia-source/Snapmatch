# ============================================================================
# Mobile Parts Finder — environment variables
# ----------------------------------------------------------------------------
# NAMES ONLY. This file is committed; it must never hold a real value.
#
# Set the real values in the Vercel project:
#   Vercel -> mobile-parts-finder -> Settings -> Environment Variables
# Add them to Production, Preview and Development, then redeploy — a function
# only picks up an environment variable on a new deployment.
#
# For local work, copy this to .env.local (git-ignored) and use TEST keys only.
# ============================================================================

# ---------------------------------------------------------------- Razorpay
# Dashboard -> Settings -> API Keys. Use rzp_test_* until every case in
# docs/RAZORPAY.md passes, then swap in rzp_live_*.
# KEY_ID is public: it is sent to the browser to open Checkout.
# KEY_SECRET is not, and must never appear in src/ or in any response body.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks. A SEPARATE secret from the key secret;
# you choose this string when creating the webhook.
# Webhook URL: https://www.mobilepartsfinder.com/api/razorpay-webhook
# Events: payment.captured, payment.authorized, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Firebase
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the WHOLE JSON file as one value.
#
# If the dashboard mangles the private key's newlines, base64 the file instead
# and use the _B64 variable — the code accepts either:
#   certutil -encode key.json key.b64   (Windows)
#   base64 -w0 key.json                 (Linux/macOS)
# THE PROJECT BOUNDARY. This is the service account of the MOBILE PARTS FINDER
# Firebase project and of no other: it is the only database this code writes
# to. A key for the Dashboard or ProGlide project here is refused at run time
# (api/_schema/projects.js). Never put another project's key in this
# environment, and never commit one.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=

# ------------------------------------------------- Firebase web app (public)
# Console -> Project settings -> General -> Your apps -> SDK setup.
#
# Served to the browser by /api/firebase-config. These are PUBLIC by design:
# the SDK cannot reach the project without them, and apiKey is a project
# identifier rather than a credential. What protects the data is Firestore
# rules and the authorised-domain list. Keeping them here is so there is one
# place to change them, not because they are secret.
#
# PROJECT ID: mobilepartsfindercom   (from the console URL — it ends "com",
# which is the project name, not a domain suffix)
#
# ---------------------------------------------------------------------------
# CHANGING THE FIREBASE PROJECT? THERE ARE THREE PLACES, NOT ONE.
#
#   1. FIREBASE_PROJECT_ID below, plus FIREBASE_API_KEY and FIREBASE_APP_ID
#      from the new project's SDK setup. This is what the BROWSER signs in to.
#      IT IS THE VERCEL ENVIRONMENT THAT MATTERS, NOT THIS FILE. This file is
#      an example; /api/firebase-config reads the real value from Vercel, and
#      editing only this one changes nothing about what the site does.
#   2. FIREBASE_SERVICE_ACCOUNT — a key issued by the NEW project. This is what
#      the SERVER verifies ID tokens with, and a token minted by one project is
#      refused by another. Leaving the old key here gives the worst symptom in
#      the system: Google sign-in works perfectly and then every authenticated
#      request 401s, with nothing on screen pointing at the environment.
#      `curl /api/health` now reports both project ids side by side and fails
#      `ok` when they disagree — check it after any change here.
#   3. vercel.json — the `/__/auth/(.*)` route proxies to
#      https://<project>.firebaseapp.com and is a literal string, because Vercel
#      routes cannot read environment variables. It must be edited by hand.
#
# And in the new project's console: enable the Google sign-in provider, and add
# mobilepartsfinder.com and www.mobilepartsfinder.com under
# Authentication -> Settings -> Authorised domains. Then deploy the rules and
# indexes to it (`firebase deploy --only firestore` — .firebaserc already
# names mobilepartsfindercom as the default project).
#
# BILLING. mobilepartsfindercom is on the Spark (no-cost) plan, and its
# (default) Firestore database works there within the daily free quota
# (50k reads / 20k writes / 20k deletes). If Firestore answers EVERY request —
# browser and Admin SDK alike — with 7 PERMISSION_DENIED, the project itself is
# refusing: it has been deleted, or it was a Blaze project whose billing was
# switched off. That is what happened to the old `mobilepartsfinder` project;
# probe `curl https://www.mobilepartsfinder.com/api/health?deep=1` first.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=mobilepartsfindercom
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Derived from the project id when unset (mobilepartsfindercom.firebaseapp.com).
#
# Setting it to the site's OWN host — www.mobilepartsfinder.com — makes the
# redirect sign-in flow same-origin, which is what stops mobile browsers
# discarding the pending sign-in as third-party storage. vercel.json already
# proxies /__/auth/* to the Firebase auth domain, which is what makes that work.
# Optional: sign-in uses a popup by default and does not need it.
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
# only if Analytics is enabled:
FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------- owner account
# Optional, and recommended once the owner has signed in to the new project.
# The Firebase UID of the owner account (Stark.ai.India@gmail.com), copied from
# Firebase console -> Authentication -> Users. When set, admin access needs
# BOTH this uid and the verified owner email on the ID token; unset, the
# verified email alone decides (see api/_schema/roles.js). Not a secret.
OWNER_UID=

# ------------------------------------------------- Local AI gateway (optional)
# The address of YOUR Local LLM service. It runs on a machine you control — a
# server, a rented GPU host, a box on the office network — and NOT inside this
# deployment: a Vercel function is a short-lived container with no GPU, and a
# browser cannot hold a production model either.
#
# The contract is one endpoint:  POST {AI_GATEWAY_URL}/v1/task
#   Authorization: Bearer {AI_GATEWAY_TOKEN}
#   body: { capability, model, systemHint, input }
#   200:  { message?: string, ...capability-specific fields }
# See docs/AI-ARCHITECTURE.md.
#
# Leave BOTH unset and every AI feature reports itself unavailable by name.
# Nothing is faked, and the chatbot still works from the database alone —
# which is its normal mode, not a fallback.
#
# A URL without a token counts as unconfigured on purpose: an unauthenticated
# AI endpoint reachable from a public serverless function is somebody else's
# free GPU, billed to you.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
# Optional. Which model the gateway should load, when it offers a choice.
AI_GATEWAY_MODEL=
# Optional. Milliseconds before a model call is abandoned. Default 20000.
AI_GATEWAY_TIMEOUT_MS=

# ------------------------------------ Instagram compatibility importer (optional)
# The ONLY way the importer reads Instagram is Meta's official Graph API.
# Instagram web pages are never fetched (backend/sources.js: instagram-web is
# allowed:false). Leave these unset and every import reports "Unable to
# collect" by name; manual entry of text an admin read still works.
#
# Setup (Meta for Developers): an app with Facebook Login for Business, the
# business's Instagram PROFESSIONAL account linked to a Facebook Page, and the
# instagram_basic + pages_read_engagement permissions (Business Discovery also
# needs the app to be live / approved for them). Business Discovery reads OTHER
# accounts only if they are public Business/Creator accounts; personal and
# private accounts cannot be read, by design.
#
# A long-lived user token lasts ~60 days; a Business Manager system-user token
# does not expire and is the better choice for a server. Server-side only.
INSTAGRAM_GRAPH_ACCESS_TOKEN=
# The numeric IG user id of YOUR professional account (not the username).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional but recommended: the Meta app secret. Every call then carries
# appsecret_proof, so a leaked token is useless without it.
INSTAGRAM_APP_SECRET=
# Optional. Default v25.0.
INSTAGRAM_GRAPH_API_VERSION=
#
# ---- Reading the media: cheap first, expensive only when necessary ----
# (docs/INSTAGRAM-IMPORTER.md §3). All keys are server-side only. A key that is
# SET is not a key that WORKS: after deploying, press "Verify the providers
# with a real call" on the importer page, or run
#   node scripts/instagram-verify-providers.js
#
# Gemini — the PRIMARY media reader: images, carousels and video itself.
# A Google AI Studio / Gemini API key.
GEMINI_API_KEY=
# Optional. The deep read (default gemini-3.8-flash) and the cheap screen that
# decides whether a deep read is worth it (default gemini-3.1-flash-lite).
INSTAGRAM_GEMINI_MODEL=
INSTAGRAM_GEMINI_SCREEN_MODEL=
# Claude — a SECOND OPINION on the few lists that are still doubtful (low
# confidence, an entry that fits several catalogue records, an unclear
# category, a machine-read conflict). Never every post. Optional: without it
# those lists go to manual review.
ANTHROPIC_API_KEY=
# anthropic | none. Default: anthropic when its key is set and Claude is not
# also the reader.
INSTAGRAM_VALIDATOR=
# Optional. Default claude-opus-5-5, effort medium (low|medium|high|xhigh|max).
INSTAGRAM_CLAUDE_MODEL=
INSTAGRAM_CLAUDE_EFFORT=
# Confidence routing (0–1). A reading below VALIDATE_BELOW gets a second
# opinion (default 0.70); at or above CONFIDENCE_HIGH it goes straight to
# database matching (default 0.90).
INSTAGRAM_VALIDATE_BELOW=
INSTAGRAM_CONFIDENCE_HIGH=
# Who reads images: gemini | anthropic | gateway | none. Default: gemini when
# its key is set, else anthropic, else the gateway, else none.
INSTAGRAM_VISION_PROVIDER=
# Who reads video: gemini (the file itself, two passes) | gateway (key frames +
# transcript through video_analyze) | none (captions and covers only).
# Default: gemini when its key is set, else the gateway. Either way the video
# is only read when Instagram hands it over; a cover is never called a video.
INSTAGRAM_VIDEO_PROVIDER=
# Frames a second for the deep video read (default 2, 0.2–5) and the largest
# video that will be fetched, in bytes (default 60 MB).
INSTAGRAM_VIDEO_FPS=
INSTAGRAM_MAX_VIDEO_BYTES=
# Optional plain OCR: gateway (media_ocr), google_vision (needs
# GOOGLE_VISION_API_KEY and billing on the Cloud project) or none. Default:
# the gateway when AI_GATEWAY_* is set, else google_vision when its key is set,
# otherwise none. Gemini reads images without it.
INSTAGRAM_OCR_PROVIDER=
GOOGLE_VISION_API_KEY=
# A post the cheap filter scores as repair content is not sent to any reader
# ("Analyse anyway" on its card overrules that for one post). "true" reads
# every such post.
INSTAGRAM_READ_REPAIR_MEDIA=
#
# The AI budget of ONE import. When any is spent the remaining posts are
# QUEUED ("AI processing budget reached — remaining items queued") and Resume
# starts a new budget. Defaults: 40 posts with AI, 60 Gemini calls, 10 Claude
# calls, 20 minutes of video.
INSTAGRAM_MAX_AI_ITEMS_PER_SYNC=
INSTAGRAM_MAX_GEMINI_CALLS_PER_SYNC=
INSTAGRAM_MAX_CLAUDE_VALIDATION_CALLS_PER_SYNC=
INSTAGRAM_MAX_VIDEO_MINUTES_PER_SYNC=
# Retries of a failed AI call before the item is marked for retry (default 1).
INSTAGRAM_AI_RETRIES=
# Cost estimates use the list prices in api/_services/instagram/ai-providers.js.
# Override per model prefix, USD per million tokens [input, output], as JSON:
#   {"gemini-3.8-flash":[0.75,3.75]}
INSTAGRAM_AI_PRICES=
# "false" to skip audio transcription. Default true.
INSTAGRAM_TRANSCRIBE=
# AI extraction: off | fallback (only when the rules leave something) | always.
INSTAGRAM_AI_MODE=
#
# Cost control, all optional; each is clamped to a hard ceiling in
# api/_services/instagram/config.js. Defaults: 500 posts per scan (max 2000),
# 8 key frames per video, 3 attempts per item, and per day (India time)
# 150 Graph API / 500 OCR / 200 AI / 60 video calls. The tick budget is the
# work done per request (default 8000 ms) — keep it under the function timeout.
INSTAGRAM_MAX_ITEMS_PER_JOB=
# Instagram Intelligence: a compatibility list that passes every check is
# applied to the compatibility groups as it is read, when the scan was started
# by an administrator who may approve changes. "off" sends every list to the
# review queue instead. Default: on.
INSTAGRAM_AUTO_APPLY=
# A post about a part type there is no category for (camera glass, back glass…
# — a closed list) gets its category created in the compatibility data. "off"
# leaves such a list for a person. Default: on.
INSTAGRAM_AUTO_CREATE_CATEGORIES=
INSTAGRAM_MAX_FRAMES_PER_VIDEO=
INSTAGRAM_MAX_ATTEMPTS=
INSTAGRAM_DAILY_GRAPH_CALLS=
INSTAGRAM_DAILY_OCR_CALLS=
INSTAGRAM_DAILY_AI_CALLS=
INSTAGRAM_DAILY_VIDEO_CALLS=
INSTAGRAM_TICK_BUDGET_MS=
